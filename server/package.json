{
  "name": "@fishing-work/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "fishing-work 遊戲伺服器：Express 5 靜態檔 + Socket.IO 4（各遊戲一個 namespace）",
  "scripts": {
    "dev": "PORT=3000 tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fishing-work/shared": "*",
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "socket.io-client": "^4.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
